{
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "coezmuc.vercel.app" }],
      "destination": "https://api-coezmuc.vercel.app/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "coezmuc-staging.vercel.app" }],
      "destination": "https://api-coezmuc-staging.vercel.app/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}